+/// The invoke and parameter tags of a DSML spelling, by its block opener (null: not a DSML block this walk reads).
+const Dsml = struct { invoke_open: []const u8, invoke_close: []const u8, param_open: []const u8, param_close: []const u8, attr_required: bool };
+
+fn dsmlTags(opener: []const u8) ?Dsml {
+    const D = "\u{ff5c}DSML\u{ff5c}";
+    if (std.mem.eql(u8, opener, "<" ++ D ++ " calls>") or std.mem.eql(u8, opener, "\n\n<" ++ D ++ " calls>")) return .{ .invoke_open = "<" ++ D ++ " invoke name=\"", .invoke_close = "</" ++ D ++ " invoke>", .param_open = "<" ++ D ++ " parameter name=\"", .param_close = "</" ++ D ++ " parameter>", .attr_required = false };
+    if (std.mem.eql(u8, opener, "<" ++ D ++ "tool_calls>")) return .{ .invoke_open = "<" ++ D ++ "invoke name=\"", .invoke_close = "</" ++ D ++ "invoke>", .param_open = "<" ++ D ++ "parameter name=\"", .param_close = "</" ++ D ++ "parameter>", .attr_required = true };
+    return null;
+}
+
+/// Whether every ``closer`` in an invoke's body lies inside a parameter value.
+fn closersInValues(body: []const u8, closer: []const u8, tags: Dsml) bool {
+    var c = findTag(body, 0, closer);
+    var at_param: usize = 0;
+    while (c) |at| {
+        const ps = findTag(body, at_param, tags.param_open) orelse return false;
+        at_param = ps + 1;
+        const ns = ps + tags.param_open.len;
+        const nq = std.mem.indexOfScalarPos(u8, body, ns, '"') orelse continue;
+        if (!tags.attr_required and nq == ns) continue;
+        var v = nq + 1;
+        if (std.mem.startsWith(u8, body[v..], " string=\"true\"")) {
+            v += " string=\"true\"".len;
+        } else if (std.mem.startsWith(u8, body[v..], " string=\"false\"")) {
+            v += " string=\"false\"".len;
+        } else if (tags.attr_required) continue;
+        if (v >= body.len or body[v] != '>') continue;
+        v += 1;
+        const pe = findTag(body, v, tags.param_close) orelse continue;
+        if (at < v) return false;
+        var next: ?usize = at;
+        while (next) |n| {
+            if (n >= pe) break;
+            next = findTag(body, n + closer.len, closer);
+        }
+        c = next;
+        at_param = pe + tags.param_close.len;
+    }
+    return true;
+}
+
+fn begins(rest: []const u8, tag: []const u8) bool {
+    return rest.len < tag.len and std.mem.startsWith(u8, tag, rest);
+}
+
+const Walk = union(enum) { closer: usize, more, broken };
+
+/// Reads a DSML block from just past its opener. A closer inside a parameter value does not end the block.
+fn walkDsml(text: []const u8, from: usize, tags: Dsml, closer: []const u8) Walk {
+    var p = from;
+    while (true) {
+        while (p < text.len and isSpaceByte(text[p])) p += 1;
+        if (p >= text.len) return .more;
+        const rest = text[p..];
+        if (std.mem.startsWith(u8, rest, closer)) return .{ .closer = p };
+        if (!std.mem.startsWith(u8, rest, tags.invoke_open)) return if (begins(rest, closer) or begins(rest, tags.invoke_open)) .more else .broken;
+        const ns = p + tags.invoke_open.len;
+        const q = std.mem.indexOfScalarPos(u8, text, ns, '"') orelse
+            return if (std.mem.indexOfScalar(u8, text[ns..], '<') != null) .broken else .more;
+        if (std.mem.indexOfScalar(u8, text[ns..q], '<') != null) return .broken;
+        if (q + 2 > text.len) return .more;
+        if (!std.mem.startsWith(u8, text[q..], "\">")) return .broken;
+        const e = findTag(text, q + 2, tags.invoke_close) orelse return .more;
+        if (!closersInValues(text[q + 2 .. e], closer, tags)) return .broken;
+        p = e + tags.invoke_close.len;
+    }
+}
+
+fn wholeInvokes(region: []const u8, tags: Dsml) usize {
+    var n: usize = 0;
+    var pos: usize = 0;
+    while (findTag(region, pos, tags.invoke_open)) |s| {
+        pos = s + 1;
+        const ns = s + tags.invoke_open.len;
+        const q = std.mem.indexOfScalarPos(u8, region, ns, '"') orelse continue;
+        if (q == ns or !std.mem.startsWith(u8, region[q..], "\">")) continue;
+        const e = findTag(region, q + 2, tags.invoke_close) orelse continue;
+        pos = e + tags.invoke_close.len;
+        n += 1;
+    }
+    return n;
+}
+
+/// Index of the block closer. A DSML value is not escaped, so it can hold the block closer. The longer reading is
+/// kept only when it yields strictly more whole invokes than splitting at the first closer. While streaming, a block
+/// still being written stays open (null).
+pub fn blockEnd(text: []const u8, from: usize, opener: []const u8, closer: []const u8, finished: bool) ?usize {
+    const first = findTag(text, from, closer) orelse return null;
+    const tags = dsmlTags(opener) orelse return first;
+    switch (walkDsml(text, from, tags, closer)) {
+        .closer => |at| {
+            if (at == first) return at;
+            var split = wholeInvokes(text[from..first], tags);
+            var pos = first + closer.len;
+            while (findTag(text[0..at], pos, opener)) |o| {
+                const e = findTag(text, o + opener.len, closer) orelse break;
+                split += wholeInvokes(text[o + opener.len .. e], tags);
+                pos = e + closer.len;
+            }
+            return if (wholeInvokes(text[from..at], tags) > split) at else first;
+        },
+        .more => return if (finished) first else null,
+        .broken => return first,
+    }
+}
