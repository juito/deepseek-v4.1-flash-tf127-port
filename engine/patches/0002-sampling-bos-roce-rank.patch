diff --git a/zig/src/families/deepseek_v41/tp_publish.zig b/zig/src/families/deepseek_v41/tp_publish.zig
new file mode 100644
index 0000000..32aec75
--- /dev/null
+++ b/zig/src/families/deepseek_v41/tp_publish.zig
@@ -0,0 +1,57 @@
+//! Copy the server's `--tp` / `--rank` / `--master` onto the names `tp.Config.fromEnv` reads.
+//! An explicit TF_TP_* value already in the environment is left as it is.
+
+const std = @import("std");
+
+extern "c" fn getenv(name: [*:0]const u8) ?[*:0]u8;
+extern "c" fn setenv(name: [*:0]const u8, value: [*:0]const u8, overwrite: c_int) c_int;
+extern "c" fn unsetenv(name: [*:0]const u8) c_int;
+
+pub const Place = struct {
+    tp: u32,
+    rank: u32,
+    master: []const u8,
+    master_port: u16,
+};
+
+fn put(name: [*:0]const u8, text: [:0]const u8) void {
+    if (getenv(name) != null) return;
+    _ = setenv(name, text.ptr, 0);
+}
+
+fn putInt(comptime name: [*:0]const u8, n: u32) void {
+    var buf: [16]u8 = undefined;
+    const text = std.fmt.bufPrintSentinel(&buf, "{d}", .{n}, 0) catch return;
+    put(name, text);
+}
+
+/// World 1 does not publish: the session's own default stays. A set TF_TP_* name is not replaced.
+pub fn publish(p: Place) void {
+    if (p.tp < 2) return;
+    putInt("TF_TP_WORLD", p.tp);
+    putInt("TF_TP_RANK", p.rank);
+    putInt("TF_TP_PORT", p.master_port);
+    if (p.master.len == 0 or p.master.len >= 256) return;
+    var buf: [256]u8 = undefined;
+    @memcpy(buf[0..p.master.len], p.master);
+    buf[p.master.len] = 0;
+    put("TF_TP_MASTER", buf[0..p.master.len :0]);
+}
+
+test "publish copies --tp onto TF_TP_* and does not replace a name already set" {
+    const names = [_][:0]const u8{ "TF_TP_WORLD", "TF_TP_RANK", "TF_TP_PORT", "TF_TP_MASTER" };
+    for (names) |n| _ = unsetenv(n.ptr);
+    defer {
+        for (names) |n| _ = unsetenv(n.ptr);
+    }
+    publish(.{ .tp = 1, .rank = 0, .master = "10.0.0.1", .master_port = 29551 });
+    try std.testing.expect(getenv("TF_TP_WORLD") == null);
+    publish(.{ .tp = 2, .rank = 1, .master = "100.78.243.41", .master_port = 29551 });
+    try std.testing.expectEqualStrings("2", std.mem.span(getenv("TF_TP_WORLD").?));
+    try std.testing.expectEqualStrings("1", std.mem.span(getenv("TF_TP_RANK").?));
+    try std.testing.expectEqualStrings("29551", std.mem.span(getenv("TF_TP_PORT").?));
+    try std.testing.expectEqualStrings("100.78.243.41", std.mem.span(getenv("TF_TP_MASTER").?));
+    publish(.{ .tp = 2, .rank = 0, .master = "other", .master_port = 1 });
+    try std.testing.expectEqualStrings("1", std.mem.span(getenv("TF_TP_RANK").?));
+    try std.testing.expectEqualStrings("100.78.243.41", std.mem.span(getenv("TF_TP_MASTER").?));
+}
