# Balanced profile: day-to-day serving at the full window, 2.9 bpw EAQ v1 unchanged.
# Apply with: scripts/profile.sh balanced

CONTEXT=1048576                # the model's window
PARALLEL=4
MAX_TOKENS=32768
THINKING=1
PREFILL_INTERLEAVE_MS=250
GRAPHS=1
GRAPH_CAP=128
RDMA_IDLE_S=2
RDMA_NAP_US=500
SPILL_GIB=64

# Local Engram tables: the largest first-token lever. Set it.
# HEAD_ENGRAM_DIR=/home/you/.cache/dsv41-tensorfold/engram-1bae0e10
