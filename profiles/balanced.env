# Balanced profile: day-to-day serving, 2.9 bpw EAQ v1 unchanged.
# Apply with: scripts/profile.sh balanced
# The model's window is 1,048,576. This pair does not use it: the live serve
# is 524288, and a 464K-token turn was killed at CONTEXT=655360.

CONTEXT=524288                 # cap: live serve is 524288; do not raise to 1048576
PARALLEL=4
MAX_TOKENS=32768
THINKING=1
PREFILL_INTERLEAVE_MS=250
GRAPHS=1
GRAPH_CAP=128
RDMA_IDLE_S=2
RDMA_NAP_US=500
SPILL_GIB=64

# Local Engram tables: the largest first-token lever. Set it.
# HEAD_ENGRAM_DIR=/home/you/.cache/dsv41-tensorfold/engram-1bae0e10
