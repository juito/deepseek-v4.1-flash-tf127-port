# TTFT profile: interactive chat, 512K window, 2.9 bpw EAQ v1 unchanged.
# Every value is scheduling. Nothing here touches the weights.
# Apply with: scripts/profile.sh ttft

CONTEXT=524288                 # practical limit on a head that runs other software
PARALLEL=4                     # the family was measured at 4 streams
MAX_TOKENS=8192                # smaller admission reservation -> fewer requests queue
THINKING=1
PREFILL_INTERLEAVE_MS=250      # a cold long prompt no longer freezes a chat
GRAPHS=1
GRAPH_CAP=128                  # bounded graph cache; uncapped is what memguard killed
RDMA_IDLE_S=2
RDMA_NAP_US=500
SPILL_GIB=64                   # a 237K conversation resumes in 1.7 s instead of 118 s

# The single largest TTFT lever: Engram's tables (shards 47/48, ~203 GB) on this
# Spark's own disk. Over NFS prefill falls to ~690-890 tok/s against ~2.1K locally.
# Point this at the folder you hardlinked them into, then verify with tools/ttft.py.
# HEAD_ENGRAM_DIR=/home/you/.cache/dsv41-tensorfold/engram-1bae0e10

TF_DS_PROMPT_WINDOW_ROWS=128   # ~40 ms off TTFT for prompts of 64-127 tokens
TF_DS_PROMPT_GEMM_ROWS=128
TF_FILL_CHUNKS=1               # a short prompt cuts in between a long pass's pieces
TF_FILL_CUT_IN=8192
