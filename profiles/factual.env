# Factual profile: greedy decoding, thinking capped, reasoning drift suppressed.
# Apply with: scripts/profile.sh factual
# Read docs/accuracy.md first: this removes sampling variance and stops the
# think block from eating the whole reply. It does not teach the model facts.

CONTEXT=524288
PARALLEL=4
MAX_TOKENS=8192
THINKING=1
REASONING_EFFORT=high
THINKING_BUDGET=4096           # must stay below MAX_TOKENS; closes the think block so an answer follows
TEMPERATURE=0                  # greedy: no sampling variance
TOP_P=1
TOP_K=20                       # the family's sampler needs a top-k; above 56 is refused
DROP_REASONING_HISTORY=1       # stops long agent runs drifting into repeating reasoning (patch 0057)
GRAPHS=1
GRAPH_CAP=128
RDMA_IDLE_S=2
RDMA_NAP_US=500
SPILL_GIB=64

# Local Engram tables: still the largest first-token lever. Set it.
# HEAD_ENGRAM_DIR=/home/you/.cache/dsv41-tensorfold/engram-1bae0e10
