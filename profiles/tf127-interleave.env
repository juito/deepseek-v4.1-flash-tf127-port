# Replay tier plus a fixed 250 ms decode budget after each prefill piece.
# TF_DSV41_PREFILL_INTERLEAVE_MS is the overlay knob in kv/sched.zig. Unset keeps
# upstream's share (TF_DSV41_PREFILL_SHARE, default 0.5). The fork's 250 ms
# measurements (longest gap 1.3 s, cancel 0.74 s, long-prompt TTFT about 8% higher)
# were on fbbc971. They are not 1.2.7 results.
CONTEXT=524288
PARALLEL=4
TF_DSV41_CONTEXT=524288
TF_DSV41_PREFILL=replay
TF_DSV41_SESSION_DISK=/nvme/dsv41-sessions
TF_DSV41_SESSION_DISK_GIB=64
TF_DSV41_SESSION_RESIDENT_GIB=3
TF_DSV41_PREFILL_PIECES=1
TF_DSV41_OWN_PREFILL=1
TF_DSV41_PROMPT_TAIL=verify
TF_DSV41_PREFILL_CUT_IN=8192
TF_DSV41_PREFILL_INTERLEAVE_MS=250
