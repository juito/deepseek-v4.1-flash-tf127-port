# Same as tf127-replay.env with the resident cap at 2 GiB.
# Use this when the MemAvailable trough on either Spark is under 4 GiB.
# Still set the same cap on both ranks. Still local NVMe, 64 GiB disk budget.
CONTEXT=524288
PARALLEL=4
TF_DSV41_CONTEXT=524288
TF_DSV41_PREFILL=replay
TF_DSV41_SESSION_DISK=/nvme/dsv41-sessions
TF_DSV41_SESSION_DISK_GIB=64
TF_DSV41_SESSION_RESIDENT_GIB=2
