# Long-context profile: 1M window, more resident conversations, 2.9 bpw EAQ v1 unchanged.
# Apply with: scripts/profile.sh long-context
# This profile buys context and residency, not first-token speed: KV sharding costs
# 1-4% decode. Use ttft.env when first token is the thing you are optimizing.

CONTEXT=1048576
POOL=2097152                   # 2x the window so more kept prompts stay resident
PARALLEL=4
MAX_TOKENS=32768
THINKING=1
KV_SHARD=1                     # one part a Spark: ~half the KV memory per rank
PREFILL_INTERLEAVE_MS=250
GRAPHS=1
GRAPH_CAP=128
SPILL_GIB=64

# Local Engram tables: the largest first-token lever. Set it.
# HEAD_ENGRAM_DIR=/home/you/.cache/dsv41-tensorfold/engram-1bae0e10
