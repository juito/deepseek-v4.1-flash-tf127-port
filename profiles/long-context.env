# Long-context profile: the largest window this pair holds, plus a bigger pool.
# Apply with: scripts/profile.sh long-context
# CONTEXT is capped at 524288 (the live serve). The model's 1,048,576 window is
# not used here: a 464K-token turn was killed at CONTEXT=655360. POOL stays
# above the window so more kept prompts stay resident. KV sharding costs 1-4%
# decode. Use ttft-fill.env or ttft-interleave.env when first token is the target.

CONTEXT=524288                 # cap: live serve is 524288; a 464K-token turn was killed at CONTEXT=655360
POOL=2097152                   # above the window so more kept prompts stay resident
PARALLEL=4
MAX_TOKENS=32768
THINKING=1
KV_SHARD=1                     # one part a Spark: ~half the KV memory per rank
PREFILL_INTERLEAVE_MS=250
GRAPHS=1
GRAPH_CAP=128
SPILL_GIB=64

# Local Engram tables: the largest first-token lever. Set it.
# HEAD_ENGRAM_DIR=/home/you/.cache/dsv41-tensorfold/engram-1bae0e10
