# Residency profile: spend the RAM left after the weights on kept conversations.
# Apply with: scripts/profile.sh residency
# Check the budget first: scripts/memory-plan.sh 9
# This buys first-token latency and concurrency, not decode rate.

CONTEXT=1048576
POOL=2097152                   # ~2 GiB a rank; the documented four-500K-stream case
KV_SHARD=0                     # 9 GiB spare means you do not need sharding's 1-4% decode cost
PARALLEL=4
MAX_TOKENS=32768
THINKING=1
PREFILL_INTERLEAVE_MS=250
GRAPHS=1
GRAPH_CAP=128                  # do not raise: decode equals uncapped at 128, each graph costs ~1.6x host
RDMA_IDLE_S=2
RDMA_NAP_US=500
SPILL_GIB=64

# Local Engram tables: still the largest first-token lever. Set it.
# HEAD_ENGRAM_DIR=/home/you/.cache/dsv41-tensorfold/engram-1bae0e10
