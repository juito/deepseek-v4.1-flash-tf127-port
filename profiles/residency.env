# Residency profile: spend the RAM left after the weights on kept conversations.
# Apply with: scripts/profile.sh residency
# Check the budget first with the GiB you actually see free.
# scripts/memory-plan.sh 9 treats 9 as an unmeasured assumption; the recipe
# records ~6.2-6.5 GiB MemAvailable after load.
# This buys first-token latency and concurrency, not decode rate.

CONTEXT=524288                 # cap: live serve is 524288; a 464K-token turn was killed at CONTEXT=655360
POOL=2097152                   # ~2 GiB a rank; kept conversations, not a larger request window
KV_SHARD=0                     # sharding costs 1-4% decode. The "9 GiB spare" figure is unmeasured
PARALLEL=4
MAX_TOKENS=32768
THINKING=1
PREFILL_INTERLEAVE_MS=250
GRAPHS=1
GRAPH_CAP=128                  # do not raise: decode equals uncapped at 128, each graph costs ~1.6x host
RDMA_IDLE_S=2
RDMA_NAP_US=500
SPILL_GIB=64

# Local Engram tables: still the largest first-token lever. Set it.
# HEAD_ENGRAM_DIR=/home/you/.cache/dsv41-tensorfold/engram-1bae0e10
