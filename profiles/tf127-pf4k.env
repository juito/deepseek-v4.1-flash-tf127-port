# Optional. Exactness-gated. Not the SparkOne default.
# TF_DSV41_PF_4K=1 holds about 0.66 GiB more worker memory than 2,048-row segments
# (serve_knobs.zig). SparkOne's headroom is about 2-3 GiB. scripts/gate.sh aborts
# if MemAvailable drops under 3.5 GiB on either node.
# Required together, from serve_knobs.zig and serve_knobs_apply.zig:
#   TF_DSV41_PF_4K=1
#   TF_DSV41_PF_4K_MEMORY_OK=1
#   TF_DSV41_GM_V2=1          (also accepts "split"; "0" is refused with PF_4K)
#   TF_DSV41_PREFILL=replay
# Keep the resident cap. Run token equality against tf127-replay before keeping this.
CONTEXT=524288
# Four agents, same slot and pool knobs as tf127-replay.env.
PARALLEL=4
TF_DSV41_SLOTS=4
TF_DSV41_POOL_TOKENS=1048576
POOL=1048576
TF_DSV41_SLOT_DRAFTS=1
TF_DSV41_SESSION_SLOTS=1
TF_DSV41_CONTEXT=524288
TF_DSV41_PREFILL=replay
TF_DSV41_SESSION_DISK=/nvme/dsv41-sessions
TF_DSV41_SESSION_DISK_GIB=64
TF_DSV41_SESSION_RESIDENT_GIB=3
TF_DSV41_PF_4K=1
TF_DSV41_PF_4K_MEMORY_OK=1
TF_DSV41_GM_V2=1
