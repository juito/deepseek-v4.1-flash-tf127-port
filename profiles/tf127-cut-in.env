# Short request during a long prefill, on the replay tier.
# TF_DSV41_PREFILL_PIECES=1 needs TF_DSV41_OWN_PREFILL=1 and TF_DSV41_PROMPT_TAIL=verify
# or prompts run whole (serve_engine.zig).
# TF_DSV41_PREFILL_CUT_IN is the alias of TF_DSV41_BATCH_SHORT added in the overlay
# (kv/sched.zig). Prompts with at most this many tokens left run every round.
# TF_DSV41_PREFILL_INTERLEAVE_MS=0 adds no decode debt. Mia's 3.84 s vs 26 s was
# measured on the fork. It is not a 1.2.7 result.
# Do not set TF_DSV41_PIECES_FLOOR. The upstream hard floor defaults to 4.0 GiB
# and would refuse work on SparkOne's 2-3 GiB headroom.
CONTEXT=524288
PARALLEL=4
TF_DSV41_CONTEXT=524288
TF_DSV41_PREFILL=replay
TF_DSV41_SESSION_DISK=/nvme/dsv41-sessions
TF_DSV41_SESSION_DISK_GIB=64
TF_DSV41_SESSION_RESIDENT_GIB=3
TF_DSV41_PREFILL_PIECES=1
TF_DSV41_OWN_PREFILL=1
TF_DSV41_PROMPT_TAIL=verify
TF_DSV41_PREFILL_CUT_IN=8192
TF_DSV41_PREFILL_INTERLEAVE_MS=0
