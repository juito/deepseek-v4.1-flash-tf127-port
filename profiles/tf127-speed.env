# Speed trial against Mia's full-prefill shape. Same slots, pool, context and weights
# as tf127-baseline.env. The extra knobs are ones upstream says keep the bits:
# x3gm v2 (gm2pf.zig: same bits as v1, rings cut to fit sm_121) and the decode
# round graph (TF_DSV41_ROUND_GRAPH). RoCE is the launcher default, not a weight change.
# Engram AIO matches Mia's ENGRAM_AIO=1 when io_uring is unavailable in the container.
# Measure this profile. Keep tf127-baseline.env for the fair 1.2.7 comparison.
CONTEXT=524288
PARALLEL=4
TF_DSV41_SLOTS=4
TF_DSV41_POOL_TOKENS=1048576
POOL=1048576
TF_DSV41_SLOT_DRAFTS=1
TF_DSV41_SESSION_SLOTS=1
TF_DSV41_CONTEXT=524288
TF_DSV41_PREFILL=full
TF_DSV41_SESSION_RESIDENT_GIB=0.5
TF_DSV41_SERVE_DIP_GIB=2.5
TF_DSV41_SAMPLING=1
TF_DSV41_GM_V2=1
TF_DSV41_ROUND_GRAPH=1
TF_DSV41_ENGRAM_AIO=1
TF_COMM_BACKEND=roce
