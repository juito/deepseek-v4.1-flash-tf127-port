# Optional. Exactness-gated. Separate from the replay default.
# TF_DSV41_PREFETCH_AHEAD=1 reads the next prompt segment's Engram pages early
# (serve_knobs.zig; default off). Run token equality against tf127-replay.
CONTEXT=524288
# Four agents, same slot and pool knobs as tf127-replay.env.
PARALLEL=4
TF_DSV41_SLOTS=4
TF_DSV41_POOL_TOKENS=1048576
POOL=1048576
TF_DSV41_SLOT_DRAFTS=1
TF_DSV41_SESSION_SLOTS=1
TF_DSV41_CONTEXT=524288
TF_DSV41_PREFILL=replay
TF_DSV41_SESSION_DISK=/nvme/dsv41-sessions
TF_DSV41_SESSION_DISK_GIB=64
TF_DSV41_SESSION_RESIDENT_GIB=3
TF_DSV41_PREFETCH_AHEAD=1
