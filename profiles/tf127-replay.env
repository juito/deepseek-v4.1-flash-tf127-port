# Main TTFT trial: replay plus a capped NVMe session tier (upstream #2182).
# Upstream measured a 319K restore in 1.2-1.4 s against 155-178 s cold, on two
# GB10s at TP=2, replies byte-identical. That number is upstream's, not this repo's.
# TF_DSV41_SESSION_RESIDENT_GIB=3 on BOTH ranks. Unset is unlimited and unsafe.
# A follower with a different cap refuses on both (session_budget.zig).
# Fallback when the MemAvailable trough is under 4 GiB: tf127-replay-2gib.env.
# Point TF_DSV41_SESSION_DISK at this Spark's local NVMe before start. Not NFS.
# Budget 64 GiB (the engine default when the directory is set; pinned here).
# Do not lower TENSORFOLD_MEMORY_RESERVE_GIB. Do not raise the pool. EAQ v1 only.
CONTEXT=524288
# Four agents, same knobs as tf127-baseline.env: SLOTS=4, the live 1M pool,
# slot drafts, and session slots. Both ranks must match.
PARALLEL=4
TF_DSV41_SLOTS=4
TF_DSV41_POOL_TOKENS=1048576
POOL=1048576
TF_DSV41_SLOT_DRAFTS=1
TF_DSV41_SESSION_SLOTS=1
TF_DSV41_CONTEXT=524288
TF_DSV41_PREFILL=replay
TF_DSV41_SESSION_DISK=/nvme/dsv41-sessions
TF_DSV41_SESSION_DISK_GIB=64
TF_DSV41_SESSION_RESIDENT_GIB=3
